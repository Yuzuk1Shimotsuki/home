# 站點信息
VITE_SITE_NAME = "無名の主頁" # 名稱
VITE_SITE_AUTHOR = "無名" # 作者
VITE_SITE_KEYWORDS = "無名,個人主頁" # 關鍵詞
VITE_SITE_DES = "一個默默無聞的主頁" # 網站簡介
VITE_SITE_URL = "lolicon.wtf" # 網站連結
VITE_SITE_LOGO = "/images/icon/favicon.ico" # 網站主圖示
VITE_SITE_MAIN_LOGO = "/images/icon/logo.png" # 主頁圖示
VITE_SITE_APPLE_LOGO = "/images/logo/apple-touch-icon.png" # Apple 端圖示

# 簡介
VITE_DESC_HELLO = "Hello World !"
VITE_DESC_TEXT = "一個建立於 21 世紀的小站，存活於網際網路的邊緣"
VITE_DESC_HELLO_OTHER = "Oops !"
VITE_DESC_TEXT_OTHER = "哎呀，這都被你發現了（ 再點擊一次可關閉 ）"

# 社交連結
## 請在 src/assets/socialLinks.json 文件中配置

# 網站連結
## 請在 src/assets/siteLinks.json 文件中配置
## 網站連結的圖標名稱可前往 https://www.xicons.org 自行挑選並在 src/components/Links/index.vue 中引入

# 天氣 Key
## 請前往 高德開放平台註冊 Web服務 Key
## 請注意不是 Web端 (JS API)，免費申請，每日上限 5000 次
## 此處提供的服務可能會超量從而無法訪問，請自行申請！請自行申請！請自行申請！
## 若此處設為空則調用 教書先生 API https://api.oioweb.cn/doc/weather/GetWeather
VITE_WEATHER_KEY = ""

# 建站日期
## 若不需要，請設為空即可
## 請按照 YYYY-MM-DD 格式填寫或者僅填寫年份 YYYY
VITE_SITE_START = "2020-09-05"

# ICP 備案號
## 若不需要，請設為空即可
VITE_SITE_ICP = ""

# 歌曲 API 地址
## 請參照 https://github.com/xizeyoupan/Meting-API#deno-deploy 進行 API 服務部署
## 此處提供的服務可能會超量從而無法訪問，請自行部署
## 若使用 QQ 音樂歌單，歌曲數量最好不要超出 50 首
## 備用：https://api.wuenci.com/meting/api/
VITE_SONG_API = "https://api-meting.imsyy.top/api"
# 歌曲服務器 ( netease-網易雲, tencent-qq音樂 )
VITE_SONG_SERVER = "netease"
# 播放類型 ( song-歌曲, playlist-播放列表, album-專輯, search-搜索, artist-藝術家 )
VITE_SONG_TYPE = "playlist"
# 播放 ID ( 若無需播放器，請設為空即可 )
VITE_SONG_ID = "9379831714"
